<Project>
  <!-- Removes all XAML-page items so the XAML compiler targets see empty collections
       and are skipped entirely.  The .g.cs / .g.i.cs / .xbf files from the last
       successful XAML compilation are re-used instead. -->
  <ItemGroup>
    <Page Remove="@(Page)" />
    <ApplicationDefinition Remove="@(ApplicationDefinition)" />
  </ItemGroup>

  <!-- Pre-generated XAML code-behind.  Searches recursively so that
       sub-folders in obj/x64/Debug (e.g. Controls/, Pages/, Settings/) are
       picked up automatically.  Exclude the 0-byte XamlTypeInfo.g.cs so the
       compiler doesn't try to feed that to the C# compiler. -->
  <ItemGroup>
    <Compile Include="obj\$(Platform)\$(Configuration)\**\*.g.cs"
             Exclude="obj\$(Platform)\$(Configuration)\XamlTypeInfo.g.cs" />
    <Compile Include="obj\$(Platform)\$(Configuration)\**\*.g.i.cs" />
  </ItemGroup>

  <!-- XBF files already sitting in the output directory from a prior build.
       Include as content so they stay deployed next to the .dll / .exe.
       Note: the glob will be empty if $(OutputPath) hasn't been set yet;
       MSBuild evaluates it lazily. -->
  <ItemGroup>
    <Content Include="$(OutputPath)**\*.xbf" />
  </ItemGroup>

  <!-- Ensure the generated code-behind files are recognized as inputs
       so incremental builds don't skip CoreCompile. -->
  <PropertyGroup>
    <CustomAdditionalCompileInputs>
      $(CustomAdditionalCompileInputs);
      obj\$(Platform)\$(Configuration)\**\*.g.cs;
      obj\$(Platform)\$(Configuration)\**\*.g.i.cs;
    </CustomAdditionalCompileInputs>
  </PropertyGroup>

</Project>
